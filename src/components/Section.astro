---
interface Props {
  id: string;
  title: string;
  alt?: boolean;
}
const { id, title, alt = false } = Astro.props;
---

<section id={id} class:list={['py-16 lg:py-24', alt && 'bg-page-alt']}>
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <h2 class="mb-8 flex items-center gap-4 font-serif text-3xl font-bold tracking-tight after:h-px after:flex-1 after:bg-line sm:text-4xl">
      {title}
    </h2>
    <slot />
  </div>
</section>

---
interface Props { items: { when: string; text: string }[] }
const { items } = Astro.props;
---

<ul class="divide-y divide-line border-y border-line">
  {
    items.map((it) => (
      <li class="grid gap-1 py-3.5 sm:grid-cols-[7rem_1fr] sm:gap-4">
        <span class="text-sm font-semibold text-accent sm:pt-0.5">{it.when}</span>
        <span>{it.text}</span>
      </li>
    ))
  }
</ul>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Subheading from '../components/Subheading.astro';
import Timeline from '../components/Timeline.astro';
import DatedList from '../components/DatedList.astro';
import CourseTable from '../components/CourseTable.astro';
import { profile, stats, education, teaching, work, research, courses, skills } from '../data/cv';

const icons = {
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>',
  id: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M8 6V4h8v2M3 12h18"/>',
};
const contact = [
  { icon: icons.pin, text: profile.location },
  { icon: icons.mail, text: profile.email, href: `mailto:${profile.email}` },
  { icon: icons.phone, text: profile.phone, href: `tel:${profile.phone.replace(/\s/g, '')}` },
  { icon: icons.id, text: profile.license },
];
---

<Base
  title={`${profile.name} · Hoja de vida`}
  description="Ingeniero de Sistemas y Magíster en Gestión de la Tecnología Educativa. Docente, instructor SENA, investigador y desarrollador de sistemas de información para entidades públicas en Garzón, Huila."
>
  <Header />

  <main id="contenido">
    <!-- Inicio -->
    <section id="inicio" class="border-b border-line py-14 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-8 lg:grid-cols-[1.6fr_1fr] lg:items-end">
        <div>
          <p class="mb-3.5 text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">Hoja de vida</p>
          <h1 class="mb-4 font-serif text-[clamp(2.4rem,7vw,4.2rem)] leading-[1.04] font-bold tracking-tight">
            Jesús Andrés<br />Silva Plazas
          </h1>
          <p class="mb-7 max-w-[34ch] text-lg text-muted sm:text-xl">{profile.role}</p>
          <ul class="grid gap-2.5">
            {
              contact.map((c) => (
                <li class="flex items-center gap-2.5 text-[15px] break-words text-muted">
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="size-[18px] shrink-0 fill-none stroke-accent stroke-[1.8]"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={c.icon}
                  />
                  {c.href ? <a href={c.href}>{c.text}</a> : c.text}
                </li>
              ))
            }
          </ul>
        </div>
        <dl class="grid grid-cols-2 gap-3" aria-label="Cifras destacadas">
          {
            stats.map((s) => (
              <div class="card !p-4 sm:!p-5">
                <dt class="text-[13px] leading-snug text-muted">{s.label}</dt>
                <dd class="mt-1.5 font-serif text-3xl font-bold text-accent">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <Section id="perfil" title="Perfil profesional">
      <div class="max-w-[70ch] text-[1.05rem]">
        {profile.summary.map((p) => <p class="mb-4" set:html={p} />)}
        <p class="mt-6 border-l-[3px] border-gold pl-4 font-serif text-xl leading-normal font-medium">{profile.purpose}</p>
      </div>
    </Section>

    <Section id="formacion" title="Formación académica" alt>
      <div class="grid gap-4 md:grid-cols-3">
        {
          education.map((e) => (
            <article class="card">
              <p class="tag mb-2.5">{e.tag}</p>
              <h3 class="mb-1.5 font-serif text-lg leading-snug font-semibold">{e.title}</h3>
              <p class="mb-2 text-[15px] text-muted">{e.org}</p>
              {e.meta && <p class="text-sm text-muted">{e.meta}</p>}
              {e.note && <p class="mt-2.5 text-[15px]" set:html={e.note} />}
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="docencia" title="Experiencia docente">
      <Timeline items={teaching} />
    </Section>

    <Section id="experiencia" title="Experiencia profesional" alt>
      <Timeline items={work} />
    </Section>

    <Section id="investigacion" title="Investigación">
      <p class="max-w-[70ch] text-lg" set:html={research.intro} />

      <Subheading>Reconocimientos</Subheading>
      <div class="grid gap-4 md:grid-cols-2">
        {
          research.awards.map((a) => (
            <article class="card border-t-[3px] border-t-gold">
              <p class="tag mb-2.5">{a.tag}</p>
              <h3 class="mb-1.5 font-serif text-lg font-semibold">{a.title}</h3>
              <p class="mb-2 text-[15px] text-muted">{a.org}</p>
              <p class="text-[15px]">{a.note}</p>
            </article>
          ))
        }
      </div>

      <Subheading>Artículos publicados</Subheading>
      <p class="mb-4 text-muted">
        Todos en la <em>Revista de Investigaciones Agroempresariales</em> (SENA, ISSN 2500-4468).
      </p>
      <ol class="divide-y divide-line border-y border-line">
        {
          research.articles.map((a) => (
            <li class="grid grid-cols-[3.5rem_1fr] gap-4 py-4">
              <span class="font-serif text-lg font-bold text-accent">{a.year}</span>
              <div>
                <p class="mb-1 font-medium">{a.url ? <a href={a.url} target="_blank" rel="noopener">{a.title}</a> : a.title}</p>
                <p class="text-sm text-muted">{a.authors} · {a.ref}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <Subheading>Proyectos de investigación como líder (SENA – SENNOVA)</Subheading>
      <DatedList items={research.projects} />

      <div class="grid gap-x-8 lg:grid-cols-2">
        <div>
          <Subheading>Semillero de investigación</Subheading>
          <article class="card">
            <p class="tag mb-2.5">Desde octubre de 2017 · Fundador y líder</p>
            <h3 class="mb-1.5 font-serif text-lg font-semibold">MetaTIC <span class="font-sans text-base font-normal text-muted">(SGPS-SEM-23)</span></h3>
            <p class="mb-2 text-[15px] text-muted">SENA, Centro Agroempresarial y Desarrollo Pecuario del Huila</p>
            <p class="mt-2.5 text-[15px]"><strong>Líneas:</strong> TIC aplicadas al desarrollo agropecuario sostenible, desarrollo de aplicaciones y promoción y análisis del escenario turístico.</p>
            <p class="mt-2.5 text-[15px]"><strong>Programas vinculados:</strong> Análisis y Desarrollo de Software, Producción Agropecuaria Ecológica y Gestión Contable y Financiera.</p>
          </article>
        </div>
        <div>
          <Subheading>Ponencias en eventos internacionales</Subheading>
          <ul class="bullets">
            {research.talks.map((t) => <li set:html={t} />)}
          </ul>
        </div>
      </div>

      <Subheading>Par evaluador</Subheading>
      <DatedList items={research.reviewer} />

      <Subheading>Productos de software</Subheading>
      <div class="grid gap-4 md:grid-cols-2">
        {
          research.software.map((s) => (
            <article class="card">
              <p class="tag mb-2.5">{s.tag}</p>
              <h3 class="mb-1.5 font-serif text-lg font-semibold">{s.title}</h3>
              <p class="text-[15px]">{s.note}</p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section id="complementaria" title="Formación complementaria" alt>
      <div class="grid gap-x-8 gap-y-10 lg:grid-cols-2">
        <div>
          <Subheading first>Pedagogía y docencia</Subheading>
          <CourseTable rows={courses.pedagogy} />
        </div>
        <div>
          <Subheading first>Investigación y tecnología</Subheading>
          <CourseTable rows={courses.tech} />
        </div>
      </div>
    </Section>

    <Section id="competencias" title="Competencias técnicas">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((s) => (
            <div class:list={['card', s.wide && 'lg:col-span-2']}>
              <h3 class="mb-3 font-serif text-base font-semibold">{s.group}</h3>
              <ul class="flex flex-wrap gap-2">
                {s.items.map((i) => (
                  <li class="rounded-full bg-accent-soft px-3 py-1 text-[13.5px] font-medium text-accent-ink">{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>
  </main>

  <footer class="border-t border-line py-8 text-[15px] text-muted">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-2 px-4 sm:px-8">
      <p><strong>Referencias</strong> disponibles a solicitud.</p>
      <p><a href={`mailto:${profile.email}`}>{profile.email}</a> · Garzón, Huila</p>
    </div>
  </footer>
</Base>
